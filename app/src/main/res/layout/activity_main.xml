<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layoutDirection="rtl"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="18dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            style="@style/PodTitle"
            android:text="הפודקאסטים שלי" />

        <ImageButton
            android:id="@+id/queueOpen"
            style="@style/PodIcon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_queue"
            android:contentDescription="תור ההאזנה" />

        <ImageButton
            android:id="@+id/importOpen"
            style="@style/PodIcon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_import"
            android:contentDescription="ייבוא מאפליקציה אחרת" />

        <ImageButton
            android:id="@+id/aboutOpen"
            style="@style/PodIcon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_info"
            android:contentDescription="אודות" />
    </LinearLayout>

    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="14dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <EditText
            android:id="@+id/intake"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="52dp"
            android:background="@drawable/bg_input"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:hint="שם פודקאסט או קישור"
            android:singleLine="true"
            android:imeOptions="actionDone"
            android:inputType="textUri" />

        <ImageButton
            android:id="@+id/go"
            style="@style/PodIcon.Primary"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="10dp"
            android:src="@drawable/ic_search"
            android:contentDescription="חיפוש או הוספה" />
    </LinearLayout>

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/textSecondary"
        android:textSize="14sp"
        android:paddingBottom="10dp"
        android:visibility="gone" />

    <ListView
        android:id="@+id/podcasts"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="@null"
        android:dividerHeight="12dp"
        android:listSelector="@android:color/transparent"
        android:clipToPadding="false" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/convHost"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <FrameLayout
        android:id="@+id/playerHost"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
